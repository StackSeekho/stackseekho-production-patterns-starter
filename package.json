{
  "name": "stackseekho-production-patterns-starter",
  "version": "1.0.0",
  "description": "A practical backend engineering project demonstrating production-oriented patterns using Node.js, TypeScript, Express, and PostgreSQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx node_modules/knex/bin/cli.js migrate:latest --knexfile knexfile.ts",
    "db:migrate:rollback": "tsx node_modules/knex/bin/cli.js migrate:rollback --knexfile knexfile.ts",
    "db:migrate:status": "tsx node_modules/knex/bin/cli.js migrate:status --knexfile knexfile.ts",
    "db:migrate:make": "tsx node_modules/knex/bin/cli.js migrate:make -x ts --knexfile knexfile.ts",
    "db:seed": "tsx node_modules/knex/bin/cli.js seed:run --knexfile knexfile.ts",
    "db:seed:make": "tsx node_modules/knex/bin/cli.js seed:make -x ts --knexfile knexfile.ts",
    "db:reset": "tsx node_modules/knex/bin/cli.js migrate:rollback --all --knexfile knexfile.ts && tsx node_modules/knex/bin/cli.js migrate:latest --knexfile knexfile.ts && tsx node_modules/knex/bin/cli.js seed:run --knexfile knexfile.ts"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "production-patterns",
    "backend"
  ],
  "author": "StackSeekho",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.19",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.21.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
